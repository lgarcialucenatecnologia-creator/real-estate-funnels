# Puerto del API
PORT=4000

# Cadena de conexión de MongoDB (Atlas o local).
# Si la contraseña tiene caracteres especiales (! @ # etc.), codifícalos en URL:
# ! → %21   @ → %40   # → %23   $ → %24
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dev?retryWrites=true&w=majority&appName=Cluster0

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:3000

# Contraseña del login de administrador (/admin en el frontend).
# Usa una frase larga y aleatoria, no una palabra memorable: no hay bloqueo de
# cuenta más allá del rate-limit del endpoint de login.
ADMIN_PASSWORD=cambia-esta-clave

# Clave para firmar los JWT de sesión de admin. Generar con: openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-tambien

# Duración de la sesión de admin antes de tener que volver a loguearse.
JWT_EXPIRES_IN=12h

# Enlace de invitación al grupo de WhatsApp
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/XXXXXXXXXXXXXXX

# Porcentaje mostrado en la vista de progreso
FUNNEL_PROGRESS=79

# Pixel de Meta — no es secreto, se ve en cualquier request de red al pixel.
META_PIXEL_ID=cambia-por-tu-pixel-id

# Token de la Conversions API de Meta (Events Manager → Configuración →
# Conversions API → Generar token de acceso). ESTO SÍ ES SECRETO: nunca lo
# subas al repo, va solo en este .env local y en las env vars de Render.
META_CAPI_ACCESS_TOKEN=cambia-por-tu-token-real
